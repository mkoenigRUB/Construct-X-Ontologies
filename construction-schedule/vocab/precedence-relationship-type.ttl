<https://www.construct-x.org/vocab/construction-schedule/precedence-relationship-type>
    a owl:Ontology ;
    owl:versionIRI <https://www.construct-x.org/vocab/construction-schedule/precedence-relationship-type/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Construct-X Precedence Relationship Type Vocabulary"@en ;
    dcterms:title "Construct-X-Vokabular für Typen von Anordnungsbeziehungen"@de ;
    dcterms:description "Controlled vocabulary for the four classical precedence relationship types. DIN 69900 terminology is provided as source metadata and German labels."@en ;
    dcterms:description "Kontrolliertes Vokabular für die vier klassischen Typen von Anordnungsbeziehungen. Die Terminologie nach DIN 69900 ist als Quellenmetadatum und über deutsche Benennungen hinterlegt."@de ;
