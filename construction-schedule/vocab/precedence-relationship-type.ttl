    dcterms:modified "2026-10-21"^^xsd:date ;
    vann:preferredNamespacePrefix "conx-prt" ;
    vann:preferredNamespaceUri "https://www.construct-x.org/vocab/construction-schedule/precedence-relationship-type#" .

conx-prt:PrecedenceRelationshipType
    a skos:ConceptScheme ;
    skos:prefLabel "Precedence Relationship Type"@en ;
    skos:prefLabel "Typ der Anordnungsbeziehung"@de .

conx-prt:FinishToStart
    a skos:Concept ;
    skos:notation "FS" ;
    skos:prefLabel "End-to-Start Relationship"@en ;
    skos:altLabel "Finish-to-Start Relationship"@en ;
    skos:prefLabel "Normalfolge"@de ;
    skos:altLabel "Normalfolge (NF)"@de ;
    skos:altLabel "Ende-Anfang-Folge (EA)"@de ;
    skos:inScheme conx-prt:PrecedenceRelationshipType ;
    skos:topConceptOf conx-prt:PrecedenceRelationshipType ;
    dcterms:source "DIN 69900:2009-01, 3.57" .

conx-prt:StartToStart
    a skos:Concept ;
    skos:notation "SS" ;
    skos:prefLabel "Start-to-Start Relationship"@en ;
    skos:prefLabel "Anfangsfolge"@de ;
    skos:altLabel "Anfangsfolge (AF)"@de ;
    skos:altLabel "Anfang-Anfang-Folge (AA)"@de ;
    skos:inScheme conx-prt:PrecedenceRelationshipType ;
    skos:topConceptOf conx-prt:PrecedenceRelationshipType ;
    dcterms:source "DIN 69900:2009-01, 3.2" .

conx-prt:FinishToFinish
    a skos:Concept ;
    skos:notation "FF" ;
    skos:prefLabel "Finish-to-Finish Relationship"@en ;
    skos:prefLabel "Endfolge"@de ;
    skos:altLabel "Endfolge (EF)"@de ;
    skos:altLabel "Ende-Ende-Folge (EE)"@de ;
    skos:inScheme conx-prt:PrecedenceRelationshipType ;
    skos:topConceptOf conx-prt:PrecedenceRelationshipType ;
    dcterms:source "DIN 69900:2009-01, 3.11" .

conx-prt:StartToFinish
    a skos:Concept ;
    skos:notation "SF" ;
    skos:prefLabel "Start-to-Finish Relationship"@en ;
    skos:prefLabel "Sprungfolge"@de ;
    skos:altLabel "Sprungfolge (SF)"@de ;
    skos:altLabel "Anfang-Ende-Folge (AE)"@de ;
    skos:inScheme conx-prt:PrecedenceRelationshipType ;
    skos:topConceptOf conx-prt:PrecedenceRelationshipType ;
    dcterms:source "DIN 69900:2009-01, 3.83" .
