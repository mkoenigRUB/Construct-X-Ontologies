 >
  <rdf:Description rdf:about="https://www.construct-x.org/vocab/construction-site/area-allocation-status">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/vocab/construction-site/area-allocation-status/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <dcterms:title xml:lang="en">Construct-X Area Allocation Status Vocabulary</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X-Vokabular für Flächenbelegungsstatus</dcterms:title>
    <dcterms:description xml:lang="en">Controlled statuses for time-bounded area allocations of a construction site.</dcterms:description>
    <dcterms:description xml:lang="de">Kontrollierte Statuswerte für zeitlich begrenzte Flächenbelegungen einer Baustelle.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-22</dcterms:created>
    <vann:preferredNamespacePrefix>conx-aas</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/vocab/construction-site/area-allocation-status#</vann:preferredNamespaceUri>
    <skos:prefLabel xml:lang="en">Area Allocation Status</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Flächenbelegungsstatus</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/vocab/construction-site/area-allocation-status#Planned">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://www.construct-x.org/vocab/construction-site/area-allocation-status"/>
    <skos:prefLabel xml:lang="en">Planned</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Geplant</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/vocab/construction-site/area-allocation-status#Actual">
