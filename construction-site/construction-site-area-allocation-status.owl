    <skos:inScheme rdf:resource="https://www.construct-x.org/vocab/construction-site/area-allocation-status"/>
    <skos:prefLabel xml:lang="en">Actual</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Tatsächlich</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/vocab/construction-site/area-allocation-status#Released">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://www.construct-x.org/vocab/construction-site/area-allocation-status"/>
    <skos:prefLabel xml:lang="en">Released</skos:prefLabel>
