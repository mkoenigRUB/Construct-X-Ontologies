<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasSiteArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/construction-site#isSiteAreaOf"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionField"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteArea"/>
    <rdfs:label xml:lang="en">has site area</rdfs:label>
    <skos:altLabel xml:lang="de">hat Baustellenfläche</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#usesSiteArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteInstallation"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteArea"/>
    <rdfs:label xml:lang="en">uses site area</rdfs:label>
    <skos:altLabel xml:lang="de">nutzt Baustellenfläche</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/ontology/construction-site/0.2.0"/>
    <owl:versionInfo>0.2.0</owl:versionInfo>
    <dcterms:title xml:lang="en">Construct-X Construction Site Ontology</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X-Ontologie für Baustellen</dcterms:title>
    <dcterms:description xml:lang="en">Describes the construction site as a production environment, including logistics areas, construction fields, operational site areas, transfer points, site installations, equipment, temporary facilities, utility supply, local spatial referencing and time-varying area allocations.</dcterms:description>
    <dcterms:description xml:lang="de">Beschreibt die Baustelle als Produktionsumgebung mit Baulogistikarealen, Baufeldern, operativen Baustellenflächen, Übergabepunkten, Baustelleneinrichtungen, Geräten, temporären Einrichtungen, Medienversorgung, lokaler räumlicher Referenzierung und zeitlich veränderlichen Flächenbelegungen.</dcterms:description>
    <dcterms:publisher rdf:resource="https://www.construct-x.org/id/organization/construct-x"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-22</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-22</dcterms:modified>
    <dcterms:source xml:lang="de">Construct-X working document: Ontologien &amp; Standards für Baustellen, 22 Oct 2026</dcterms:source>
    <vann:preferredNamespacePrefix>conx-site</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/ontology/construction-site#</vann:preferredNamespaceUri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#SiteArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Site Area</rdfs:label>
    <skos:altLabel xml:lang="de">Baustelleneinrichtungsfläche</skos:altLabel>
    <rdfs:comment xml:lang="en">A concrete operational or logistics area on or around a Construction Site. It is a stable spatial entity. hasAreaType denotes its standard (default) functional type; time-varying usage is expressed through AreaAllocations.</rdfs:comment>
    <rdfs:comment xml:lang="de">Konkrete operative oder logistische Fläche auf oder im Umfeld einer Baustelle. Sie ist eine stabile räumliche Entität. hasAreaType bezeichnet ihren Standard-Flächentyp; zeitlich veränderliche Nutzung wird über Flächenbelegungen (AreaAllocation) ausgedrückt.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#ConstructionField">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Construction Field</rdfs:label>
    <skos:altLabel xml:lang="de">Baufeld</skos:altLabel>
    <rdfs:comment xml:lang="en">A spatially delimited field within a Construction Site in which construction activities and site logistics take place.</rdfs:comment>
    <rdfs:comment xml:lang="de">Räumlich abgegrenztes Baufeld innerhalb einer Baustelle.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasExternalSiteArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionLogisticsArea"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteArea"/>
    <rdfs:label xml:lang="en">has external site area</rdfs:label>
    <skos:altLabel xml:lang="de">enthält externe Baustellenfläche</skos:altLabel>
    <rdfs:comment xml:lang="en">Associates the logistics area with operational areas outside the construction-site boundary, for example waiting or pre-staging areas.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#ConstructionLogisticsArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Construction Logistics Area</rdfs:label>
    <skos:altLabel xml:lang="de">Baulogistikareal</skos:altLabel>
    <rdfs:comment xml:lang="en">The overall operational area relevant to construction logistics, including areas located outside the construction-site boundary.</rdfs:comment>
    <rdfs:comment xml:lang="de">Gesamter Wirkbereich der Baulogistik einschließlich Flächen außerhalb der eigentlichen Baustellengrenze.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#TemporarySiteFacility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteInstallation"/>
    <rdfs:label xml:lang="en">Temporary Site Facility</rdfs:label>
    <skos:altLabel xml:lang="de">Temporäre Baustelleneinrichtung</skos:altLabel>
    <rdfs:comment xml:lang="en">A temporary facility such as a container system or site container.</rdfs:comment>
    <rdfs:comment xml:lang="de">Temporäre Einrichtung wie Containeranlage oder Baustellencontainer.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">identifier</rdfs:label>
    <skos:altLabel xml:lang="de">Kennung</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasLocalCoordinateSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionSite"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#LocalCoordinateSystem"/>
    <rdfs:label xml:lang="en">has local coordinate system</rdfs:label>
    <skos:altLabel xml:lang="de">hat lokales Koordinatensystem</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#rotationToGridNorth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#LocalCoordinateSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">rotation to grid north</rdfs:label>
    <skos:altLabel xml:lang="de">Rotation zu Gitternord</skos:altLabel>
    <rdfs:comment xml:lang="en">Rotation angle from the local coordinate system to grid north, expressed in degrees.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#isConstructionFieldOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionField"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionSite"/>
    <rdfs:label xml:lang="en">is construction field of</rdfs:label>
    <skos:altLabel xml:lang="de">ist Baufeld von</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasUtilityType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#UtilitySupply"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has utility type</rdfs:label>
    <skos:altLabel xml:lang="de">hat Medientyp</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <skos:altLabel xml:lang="de">Bezeichnung</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#requiresUtility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteInstallation"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#UtilitySupply"/>
    <rdfs:label xml:lang="en">requires utility</rdfs:label>
    <skos:altLabel xml:lang="de">benötigt Medium</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasFacilityType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#TemporarySiteFacility"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has facility type</rdfs:label>
    <skos:altLabel xml:lang="de">hat Einrichtungstyp</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#SiteEquipment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteInstallation"/>
    <rdfs:label xml:lang="en">Site Equipment</rdfs:label>
    <skos:altLabel xml:lang="de">Baustellengerät</skos:altLabel>
    <rdfs:comment xml:lang="en">Equipment used for construction-site production or logistics, classified by an equipment-type vocabulary.</rdfs:comment>
    <rdfs:comment xml:lang="de">Gerät für Produktion oder Logistik auf der Baustelle, klassifiziert über ein Gerätetyp-Vokabular.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#isLocatedInArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#TransferPoint"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteArea"/>
    <rdfs:label xml:lang="en">is located in area</rdfs:label>
    <skos:altLabel xml:lang="de">liegt in Fläche</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasConstructionField">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/construction-site#isConstructionFieldOf"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionSite"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionField"/>
    <rdfs:label xml:lang="en">has construction field</rdfs:label>
    <skos:altLabel xml:lang="de">hat Baufeld</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasEquipmentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteEquipment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has equipment type</rdfs:label>
    <skos:altLabel xml:lang="de">hat Gerätetyp</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#UtilitySupply">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteInstallation"/>
    <rdfs:label xml:lang="en">Utility Supply</rdfs:label>
    <skos:altLabel xml:lang="de">Medienversorgung</skos:altLabel>
    <rdfs:comment xml:lang="en">A utility supply available on the Construction Site, such as site electricity or site water.</rdfs:comment>
    <rdfs:comment xml:lang="de">Auf der Baustelle verfügbare Medienversorgung wie Baustrom oder Bauwasser.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasSiteInstallation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionSite"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteInstallation"/>
    <rdfs:label xml:lang="en">has site installation</rdfs:label>
    <skos:altLabel xml:lang="de">hat Baustelleneinrichtung</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">description</rdfs:label>
    <skos:altLabel xml:lang="de">Beschreibung</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasAreaType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteArea"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">has area type</rdfs:label>
    <skos:altLabel xml:lang="de">hat Flächentyp</skos:altLabel>
    <rdfs:comment xml:lang="en">Classifies a Site Area using a controlled area-type concept.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#TransferPoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Transfer Point</rdfs:label>
    <skos:altLabel xml:lang="de">Übergabepunkt</skos:altLabel>
    <rdfs:comment xml:lang="en">A designated location at which material, custody or responsibility is handed over.</rdfs:comment>
    <rdfs:comment xml:lang="de">Definierter Ort, an dem Material, Obhut oder Verantwortung übergeben wird.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasConstructionSite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionLogisticsArea"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionSite"/>
    <rdfs:label xml:lang="en">has construction site</rdfs:label>
    <skos:altLabel xml:lang="de">enthält Baustelle</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#crsIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#LocalCoordinateSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">coordinate reference system identifier</rdfs:label>
    <skos:altLabel xml:lang="de">Kennung des Koordinatenreferenzsystems</skos:altLabel>
    <rdfs:comment xml:lang="en">Identifier of the external coordinate reference system, for example an EPSG identifier.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#referencePoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#LocalCoordinateSystem"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:label xml:lang="en">reference point</rdfs:label>
    <skos:altLabel xml:lang="de">Fixpunkt</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#LocalCoordinateSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Local Coordinate System</rdfs:label>
    <skos:altLabel xml:lang="de">Lokales Koordinatensystem</skos:altLabel>
    <rdfs:comment xml:lang="en">A construction-site-specific coordinate system defined by a reference point, coordinate reference system identifier and rotation to grid north.</rdfs:comment>
    <rdfs:comment xml:lang="de">Baustellenspezifisches Koordinatensystem mit Referenzpunkt, Koordinatenreferenzsystem und Rotation zu Gitternord.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#ConstructionSite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Construction Site</rdfs:label>
    <skos:altLabel xml:lang="de">Baustelle</skos:altLabel>
    <rdfs:comment xml:lang="en">A project-specific construction site as an organisational and spatial production environment.</rdfs:comment>
    <rdfs:comment xml:lang="de">Projektbezogene Baustelle als organisatorische und räumliche Produktionsumgebung.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasRestrictedZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteEquipment"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteArea"/>
    <rdfs:label xml:lang="en">has restricted zone</rdfs:label>
    <skos:altLabel xml:lang="de">hat Sperrzone</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#isSiteAreaOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteArea"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#ConstructionField"/>
    <rdfs:label xml:lang="en">is site area of</rdfs:label>
    <skos:altLabel xml:lang="de">ist Baustellenfläche von</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#SiteInstallation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Site Installation</rdfs:label>
    <skos:altLabel xml:lang="de">Baustelleneinrichtung</skos:altLabel>
    <rdfs:comment xml:lang="en">A temporary production resource or infrastructure element installed or used on a Construction Site.</rdfs:comment>
    <rdfs:comment xml:lang="de">Temporäres Produktionsmittel oder Infrastrukturelement einer Baustelle.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#AreaAllocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Area Allocation</rdfs:label>
    <skos:altLabel xml:lang="de">Flächenbelegung</skos:altLabel>
    <rdfs:comment xml:lang="en">A time-bounded assignment of a functional type to a Site Area. The Site Area itself remains a stable spatial entity; its usage over time is expressed through one or more AreaAllocations, each with its own validity interval and status.</rdfs:comment>
    <rdfs:comment xml:lang="de">Zeitlich begrenzte Zuordnung eines Flächentyps zu einer Baustellenfläche. Die Fläche selbst bleibt eine stabile räumliche Entität; ihre Nutzung über die Zeit wird durch eine oder mehrere Flächenbelegungen mit jeweils eigenem Gültigkeitsintervall und Status ausgedrückt.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#hasAreaAllocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/construction-site#allocatedArea"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteArea"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#AreaAllocation"/>
    <rdfs:label xml:lang="en">has area allocation</rdfs:label>
    <skos:altLabel xml:lang="de">hat Flächenbelegung</skos:altLabel>
    <rdfs:comment xml:lang="en">Associates a Site Area with the time-bounded allocations of functional types to that area.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#allocatedArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#AreaAllocation"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#SiteArea"/>
    <rdfs:label xml:lang="en">allocated area</rdfs:label>
    <skos:altLabel xml:lang="de">belegte Fläche</skos:altLabel>
    <rdfs:comment xml:lang="en">The Site Area to which this allocation applies (exactly one area per allocation).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#allocationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#AreaAllocation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">allocation type</rdfs:label>
    <skos:altLabel xml:lang="de">Belegungstyp</skos:altLabel>
    <rdfs:comment xml:lang="en">The functional type assigned to the area during the validity interval, using the controlled area-type vocabulary.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#allocationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#AreaAllocation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">allocation status</rdfs:label>
    <skos:altLabel xml:lang="de">Belegungsstatus</skos:altLabel>
    <rdfs:comment xml:lang="en">The status of the allocation, for example planned, actual or released.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#validFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#AreaAllocation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">valid from</rdfs:label>
    <skos:altLabel xml:lang="de">gültig ab</skos:altLabel>
    <rdfs:comment xml:lang="en">Start of the validity interval of the area allocation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/construction-site#validTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#AreaAllocation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">valid to</rdfs:label>
    <skos:altLabel xml:lang="de">gültig bis</skos:altLabel>
    <rdfs:comment xml:lang="en">End of the validity interval of the area allocation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/construction-site"/>
  </rdf:Description>
</rdf:RDF>
