    skos:prefLabel "Logistics Requirement Status"@en ;
    skos:prefLabel "Status der Logistikanforderung"@de .

conx-drs:Requested a skos:Concept ; skos:inScheme <https://www.construct-x.org/vocab/construction-delivery/requirement-status> ; skos:prefLabel "Requested"@en ; skos:prefLabel "Angefragt"@de .
conx-drs:Confirmed a skos:Concept ; skos:inScheme <https://www.construct-x.org/vocab/construction-delivery/requirement-status> ; skos:prefLabel "Confirmed"@en ; skos:prefLabel "Bestätigt"@de .
conx-drs:Scheduled a skos:Concept ; skos:inScheme <https://www.construct-x.org/vocab/construction-delivery/requirement-status> ; skos:prefLabel "Scheduled"@en ; skos:prefLabel "Terminiert"@de .
conx-drs:InProgress a skos:Concept ; skos:inScheme <https://www.construct-x.org/vocab/construction-delivery/requirement-status> ; skos:prefLabel "In Progress"@en ; skos:prefLabel "In Bearbeitung"@de .
conx-drs:Completed a skos:Concept ; skos:inScheme <https://www.construct-x.org/vocab/construction-delivery/requirement-status> ; skos:prefLabel "Completed"@en ; skos:prefLabel "Abgeschlossen"@de .
conx-drs:Cancelled a skos:Concept ; skos:inScheme <https://www.construct-x.org/vocab/construction-delivery/requirement-status> ; skos:prefLabel "Cancelled"@en ; skos:prefLabel "Abgebrochen"@de .
