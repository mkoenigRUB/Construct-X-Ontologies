<https://www.construct-x.org/vocab/construction-delivery/requirement-status>
    a owl:Ontology, skos:ConceptScheme ;
    owl:versionIRI <https://www.construct-x.org/vocab/construction-delivery/requirement-status/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Construct-X Logistics Requirement Status Vocabulary"@en ;
    dcterms:created "2026-10-22"^^xsd:date ;
    vann:preferredNamespacePrefix "conx-drs" ;
