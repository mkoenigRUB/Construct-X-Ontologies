    rdfs:label "is quantity split of"@en ;
    skos:altLabel "ist Mengensplit von"@de ;
    owl:inverseOf conx-gaeb:hasQuantitySplit ;
    rdfs:isDefinedBy <https://www.construct-x.org/ontology/gaeb-boq> .

