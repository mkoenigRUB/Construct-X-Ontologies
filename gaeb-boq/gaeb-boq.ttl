conx-gaeb:referencesExternalObject
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain conx-gaeb:CatalogAssignment ;
    rdfs:range conx-gaeb:ExternalObjectReference ;
    rdfs:label "references external object"@en ;
    skos:altLabel "referenziert externes Objekt"@de ;
    rdfs:comment "References one generic external-object reference. A typed cross-domain relationship to another ontology is defined only in a separate link ontology."@en ;
    rdfs:comment "Referenziert eine generische externe Objektreferenz. Eine typisierte domänenübergreifende Beziehung zu einer anderen Ontologie wird ausschließlich in einer separaten Link-Ontologie definiert."@de ;
