    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n43871abe4d7048deb2d942eb8c22ba23b4">
