    <skos:altLabel xml:lang="de">hat obersten LV-Bereich</skos:altLabel>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#isRootSectionOf"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#sourceSystem">
