  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#quantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#QuantifiedEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">quantity</rdfs:label>
    <skos:altLabel xml:lang="de">Menge</skos:altLabel>
    <dcterms:source>GAEB DA XML 3.3</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#UnitPriceComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#IdentifiedEntity"/>
    <rdfs:label xml:lang="en">Unit Price Component</rdfs:label>
    <skos:altLabel xml:lang="de">Einheitspreisanteil</skos:altLabel>
    <rdfs:comment xml:lang="en">A monetary component of the unit price of a BoQ Item. The component is classified by a controlled price-component type.</rdfs:comment>
    <rdfs:comment xml:lang="de">Monetärer Anteil am Einheitspreis einer Leistungsposition. Der Anteil wird über einen kontrollierten Typ des Einheitspreisanteils klassifiziert.</rdfs:comment>
    <dcterms:source>GAEB DA XML 3.3</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#amount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#UnitPriceComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">amount</rdfs:label>
    <skos:altLabel xml:lang="de">Betrag</skos:altLabel>
    <rdfs:comment xml:lang="en">Monetary amount of a unit price component in the currency of the Bill of Quantities.</rdfs:comment>
    <rdfs:comment xml:lang="de">Monetärer Betrag eines Einheitspreisanteils in der Währung des Leistungsverzeichnisses.</rdfs:comment>
    <dcterms:source>GAEB DA XML 3.3</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#isQuantitySplitOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#QuantitySplit"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BoQItem"/>
    <rdfs:label xml:lang="en">is quantity split of</rdfs:label>
    <skos:altLabel xml:lang="de">ist Mengensplit von</skos:altLabel>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#hasQuantitySplit"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#unitCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#QuantifiedEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">unit code</rdfs:label>
    <skos:altLabel xml:lang="de">Mengeneinheit</skos:altLabel>
    <skos:altLabel xml:lang="de">GAEB-Einheitencode</skos:altLabel>
    <rdfs:comment xml:lang="en">Original unit value from the GAEB context. A Quantity Split may omit the value and inherit the unit from its BoQ Item in application logic.</rdfs:comment>
    <rdfs:comment xml:lang="de">Originaler Einheitenwert aus dem GAEB-Kontext. Bei einem Mengensplit kann der Wert fehlen und anwendungsseitig von der Position übernommen werden.</rdfs:comment>
    <dcterms:source>GAEB DA XML 3.3</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#ordinalIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BoQItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">ordinal index</rdfs:label>
    <skos:altLabel xml:lang="de">OZ-Index</skos:altLabel>
    <dcterms:source>GAEB DA XML 3.3</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#isSectionContainedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BoQSection"/>
    <rdfs:range rdf:nodeID="n43871abe4d7048deb2d942eb8c22ba23b12"/>
    <rdfs:label xml:lang="en">section is contained in</rdfs:label>
    <skos:altLabel xml:lang="de">LV-Bereich ist enthalten in</skos:altLabel>
    <rdfs:comment xml:lang="en">Abstract super-property for the placement of a BoQ Section as a root section or subsection.</rdfs:comment>
    <rdfs:comment xml:lang="de">Abstrakte Oberrelation für die Einordnung eines LV-Bereichs als Wurzel- oder Unterbereich.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#BoQSection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BoQComponent"/>
    <rdfs:label xml:lang="en">BoQ Section</rdfs:label>
    <skos:altLabel xml:lang="de">LV-Bereich</skos:altLabel>
    <rdfs:comment xml:lang="en">A hierarchical section of a bill of quantities. A section is either a root section or a subsection of another section.</rdfs:comment>
    <rdfs:comment xml:lang="de">Hierarchischer LV-Bereich. Ein Bereich ist entweder oberster Bereich eines LV oder Unterbereich eines anderen Bereichs.</rdfs:comment>
    <dcterms:source>GAEB DA XML 3.3</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#referencesExternalObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#CatalogAssignment"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#ExternalObjectReference"/>
    <rdfs:label xml:lang="en">references external object</rdfs:label>
    <skos:altLabel xml:lang="de">referenziert externes Objekt</skos:altLabel>
    <rdfs:comment xml:lang="en">References one generic external-object reference. A typed cross-domain relationship to another ontology is defined only in a separate link ontology.</rdfs:comment>
    <rdfs:comment xml:lang="de">Referenziert eine generische externe Objektreferenz. Eine typisierte domänenübergreifende Beziehung zu einer anderen Ontologie wird ausschließlich in einer separaten Link-Ontologie definiert.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n43871abe4d7048deb2d942eb8c22ba23b11">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BoQSection"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#BillOfQuantities">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#IdentifiedEntity"/>
    <rdfs:label xml:lang="en">Bill of Quantities</rdfs:label>
    <skos:altLabel xml:lang="de">Leistungsverzeichnis</skos:altLabel>
    <rdfs:comment xml:lang="en">A concrete bill of quantities containing either direct items or one or more root sections.</rdfs:comment>
    <rdfs:comment xml:lang="de">Konkretes Leistungsverzeichnis mit entweder direkten Positionen oder einem bzw. mehreren obersten LV-Bereichen.</rdfs:comment>
    <dcterms:source>GAEB DA XML 3.3</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#CatalogAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#IdentifiedEntity"/>
    <rdfs:label xml:lang="en">Catalog Assignment</rdfs:label>
    <skos:altLabel xml:lang="de">Katalogzuordnung</skos:altLabel>
    <rdfs:comment xml:lang="en">An assignment from a catalog-assignable BoQ resource to a generic external-object reference.</rdfs:comment>
    <rdfs:comment xml:lang="de">Zuordnung einer katalogisierbaren BoQ-Ressource zu einer generischen externen Objektreferenz.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#longText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BoQItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="en">long text</rdfs:label>
    <skos:altLabel xml:lang="de">Langtext</skos:altLabel>
    <dcterms:source>GAEB DA XML 3.3</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#ordinalNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BoQComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">ordinal number</rdfs:label>
    <skos:altLabel xml:lang="de">Ordnungszahl</skos:altLabel>
    <rdfs:comment xml:lang="en">Fully formatted ordinal number of a BoQ section or item.</rdfs:comment>
    <rdfs:comment xml:lang="de">Vollständig formatierte Ordnungszahl eines LV-Bereichs oder einer Position.</rdfs:comment>
    <dcterms:source>GAEB DA XML 3.3</dcterms:source>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#isRootSectionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BoQSection"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BillOfQuantities"/>
    <rdfs:label xml:lang="en">is root section of</rdfs:label>
    <skos:altLabel xml:lang="de">ist oberster LV-Bereich von</skos:altLabel>
    <rdfs:subPropertyOf rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#isSectionContainedIn"/>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#hasRootSection"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#QuantifiedEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#IdentifiedEntity"/>
    <rdfs:label xml:lang="en">Quantified Entity</rdfs:label>
    <skos:altLabel xml:lang="de">Entität mit Menge</skos:altLabel>
    <rdfs:comment xml:lang="en">Abstract superclass for resources that can carry a quantity and unit code.</rdfs:comment>
    <rdfs:comment xml:lang="de">Abstrakte Oberklasse für Ressourcen, denen eine Menge und eine Einheit zugeordnet werden können.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/gaeb-boq"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/gaeb-boq#hasRootSection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BillOfQuantities"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/gaeb-boq#BoQSection"/>
