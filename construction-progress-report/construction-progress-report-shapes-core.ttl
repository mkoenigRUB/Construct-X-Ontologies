@prefix conx-cpr: <https://www.construct-x.org/ontology/construction-progress-report#> .
@prefix conx-cpr-sh: <https://www.construct-x.org/shapes/construction-progress-report#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.construct-x.org/shapes/construction-progress-report/core>
    a owl:Ontology ;
    owl:versionIRI <https://www.construct-x.org/shapes/construction-progress-report/core/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://www.construct-x.org/ontology/construction-progress-report/0.1.0> ;
    dcterms:title "Construct-X Construction Progress Report Core SHACL"@en ;
    dcterms:title "Construct-X Core-SHACL für Baufortschrittsmeldungen"@de ;
    dcterms:publisher <https://www.construct-x.org/id/organization/construct-x> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

conx-cpr-sh:ConstructionProgressReportShape
    a sh:NodeShape ;
    sh:targetClass conx-cpr:ConstructionProgressReport ;

    sh:property [
        sh:path conx-cpr:identifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Construction Progress Report must have exactly one identifier."@en ;
        sh:message "Eine Baufortschrittsmeldung muss genau eine Kennung besitzen."@de
    ] ;

    sh:property [
        sh:path conx-cpr:recordedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Construction Progress Report must have exactly one recording date/time."@en ;
        sh:message "Eine Baufortschrittsmeldung muss genau einen Erfassungszeitpunkt besitzen."@de
    ] ;

    sh:property [
        sh:path conx-cpr:activityStatus ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Construction Progress Report must have exactly one activity-status IRI."@en ;
        sh:message "Eine Baufortschrittsmeldung muss genau einen Vorgangsstatus als IRI besitzen."@de
    ] ;

    sh:property [
        sh:path conx-cpr:completionPercentage ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 100 ;
        sh:maxCount 1 ;
        sh:message "completionPercentage must be between 0 and 100."@en ;
        sh:message "Der Fertigstellungsgrad muss zwischen 0 und 100 liegen."@de
    ] ;

    sh:property [
        sh:path conx-cpr:actualStart ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path conx-cpr:actualFinish ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path conx-cpr:forecastFinish ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "forecastFinish must not be present when actualFinish is present."@en ;
        sh:message "forecastFinish darf nicht vorhanden sein, wenn actualFinish vorhanden ist."@de ;
        sh:select """
            PREFIX conx-cpr: <https://www.construct-x.org/ontology/construction-progress-report#>
            SELECT $this
            WHERE {
                $this conx-cpr:actualFinish ?actual ;
                      conx-cpr:forecastFinish ?forecast .
            }
        """
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "actualFinish requires actualStart."@en ;
        sh:message "actualFinish setzt actualStart voraus."@de ;
        sh:select """
            PREFIX conx-cpr: <https://www.construct-x.org/ontology/construction-progress-report#>
            SELECT $this
            WHERE {
                $this conx-cpr:actualFinish ?finish .
                FILTER NOT EXISTS { $this conx-cpr:actualStart ?start . }
            }
        """
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "actualStart must not be later than actualFinish."@en ;
        sh:message "actualStart darf nicht nach actualFinish liegen."@de ;
        sh:select """
            PREFIX conx-cpr: <https://www.construct-x.org/ontology/construction-progress-report#>
            SELECT $this
            WHERE {
                $this conx-cpr:actualStart ?start ;
                      conx-cpr:actualFinish ?finish .
                FILTER (?start > ?finish)
            }
        """
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "actualStart must not be later than recordedAt."@en ;
        sh:message "actualStart darf nicht nach dem Erfassungszeitpunkt liegen."@de ;
        sh:select """
            PREFIX conx-cpr: <https://www.construct-x.org/ontology/construction-progress-report#>
            SELECT $this
            WHERE {
                $this conx-cpr:actualStart ?start ;
                      conx-cpr:recordedAt ?recorded .
                FILTER (?start > ?recorded)
            }
        """
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "actualFinish must not be later than recordedAt."@en ;
        sh:message "actualFinish darf nicht nach dem Erfassungszeitpunkt liegen."@de ;
        sh:select """
            PREFIX conx-cpr: <https://www.construct-x.org/ontology/construction-progress-report#>
            SELECT $this
            WHERE {
                $this conx-cpr:actualFinish ?finish ;
                      conx-cpr:recordedAt ?recorded .
                FILTER (?finish > ?recorded)
            }
        """
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "forecastFinish must not be earlier than actualStart."@en ;
        sh:message "forecastFinish darf nicht vor actualStart liegen."@de ;
        sh:select """
            PREFIX conx-cpr: <https://www.construct-x.org/ontology/construction-progress-report#>
            SELECT $this
            WHERE {
                $this conx-cpr:actualStart ?start ;
                      conx-cpr:forecastFinish ?forecast .
                FILTER (?forecast < ?start)
            }
        """
    ] .
