    <dcterms:title xml:lang="en">Construct-X Agent Ontology</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X Agent-Ontologie</dcterms:title>
    <vann:preferredNamespacePrefix>conx-agent</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/ontology/agent#</vann:preferredNamespaceUri>
