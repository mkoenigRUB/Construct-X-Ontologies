  <rdf:Description rdf:about="https://www.construct-x.org/ontology/agent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:bibliographicCitation xml:lang="en">Construct-X Agent Ontology, version 0.1.0</dcterms:bibliographicCitation>
    <dcterms:bibliographicCitation xml:lang="de">Construct-X Agent-Ontologie, Version 0.1.0</dcterms:bibliographicCitation>
    <dcterms:contributor xml:lang="de">Construction-X Arbeitspaket 3.4</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-25</dcterms:created>
    <dcterms:creator rdf:nodeID="nf534909a62ff4b19818818100cf45624b1"/>
    <dcterms:description xml:lang="de">Definiert die minimale gemeinsame Oberklasse für Akteure im Construct-X-Ontologienetzwerk.</dcterms:description>
    <dcterms:description xml:lang="en">Defines the minimal common superclass for agents in the Construct-X ontology network.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-25</dcterms:modified>
