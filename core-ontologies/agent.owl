    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/agent#Agent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Eine Entität, die in einem fachlichen Kontext handeln, Verantwortung tragen oder als Herausgeber beziehungsweise Beteiligter referenziert werden kann.</rdfs:comment>
    <rdfs:comment xml:lang="en">An entity that can act, bear responsibility, or be referenced as an issuer or participant in a domain context.</rdfs:comment>
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:label xml:lang="de">Akteur</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://data.europa.eu/m8g/Agent"/>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
  </rdf:Description>
