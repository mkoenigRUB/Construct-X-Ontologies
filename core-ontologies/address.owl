<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema="https://schema.org/"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb26">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb27"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#addressRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Bestimmt eine fachliche Rolle, in der die Adresse innerhalb der Zuordnung verwendet wird. Eine Zuordnung kann mehrere Rollen besitzen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Specifies a business role in which the address is used within the assignment. An assignment may have multiple roles.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#AddressAssignment"/>
    <rdfs:label xml:lang="en">address role</rdfs:label>
    <rdfs:label xml:lang="de">Adressrolle</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/address#AddressRole"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb23">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb24"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#additionalStreetName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Zusätzliche Straßenbezeichnung zur genaueren Bestimmung der Adresse.</rdfs:comment>
    <rdfs:comment xml:lang="en">Additional street name used to identify the address more precisely.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">additional street name</rdfs:label>
    <rdfs:label xml:lang="de">zusätzlicher Straßenname</rdfs:label>
    <rdfs:range rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#hasCountry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verweist auf das Land der Adresse.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an address to its country.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">has country</rdfs:label>
    <rdfs:label xml:lang="de">hat Land</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/address#Country"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:bibliographicCitation xml:lang="en">Construct-X Address Ontology, version 0.1.0</dcterms:bibliographicCitation>
    <dcterms:bibliographicCitation xml:lang="de">Construct-X Adressontologie, Version 0.1.0</dcterms:bibliographicCitation>
    <dcterms:contributor xml:lang="de">Construction-X Arbeitspaket 3.4</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-13</dcterms:created>
    <dcterms:creator rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb1"/>
    <dcterms:description xml:lang="de">Definiert ein strukturiertes, wiederverwendbares Modell für Adressen, kontextbezogene Adresszuordnungen und referenzierbare administrative Gebiete im Construction-X-Ontologienetzwerk.</dcterms:description>
    <dcterms:description xml:lang="en">Defines a structured, reusable model for addresses, contextual address assignments, and referenceable administrative territories in the Construction-X ontology network.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-18</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.construct-x.org/id/organization/ecbe8336-94ab-5c11-8220-94f260963eb2/revision/1"/>
    <dcterms:source rdf:resource="https://schema.org/PostalAddress"/>
    <dcterms:source rdf:resource="https://www.w3.org/TR/vcard-rdf/"/>
    <dcterms:source rdf:resource="https://docs.oasis-open.org/ubl/cs01-UBL-2.5/xsd/common/UBL-CommonAggregateComponents-2.5.xsd"/>
    <dcterms:title xml:lang="en">Construct-X Address Ontology</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X Adressontologie</dcterms:title>
    <vann:preferredNamespacePrefix>conx-addr</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/ontology/address#</vann:preferredNamespaceUri>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/ontology/address/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#localityName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Name der Ortschaft, Stadt, Gemeinde oder eines vergleichbaren Siedlungsgebiets.</rdfs:comment>
    <rdfs:comment xml:lang="en">Name of a locality, city, municipality, or comparable settlement area.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">locality name</rdfs:label>
    <rdfs:label xml:lang="de">Ortsname</rdfs:label>
    <rdfs:range rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb35"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb31">
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#careOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Empfängerhinweis im Sinn von „c/o“ oder „bei“.</rdfs:comment>
    <rdfs:comment xml:lang="en">Addressee instruction in the sense of 'care of'.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#AddressAssignment"/>
    <rdfs:label xml:lang="en">care of</rdfs:label>
    <rdfs:label xml:lang="de">bei</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#AddressAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Eine kontextbezogene Zuordnung einer Adresse zu einer anderen Ressource. Alle Angaben der Zuordnung gelten gemeinsam für alle mit ihr verknüpften Adressrollen.</rdfs:comment>
    <rdfs:comment xml:lang="en">A contextual assignment of an address to another resource. All assignment details jointly apply to every address role linked to the assignment.</rdfs:comment>
    <rdfs:label xml:lang="en">Address assignment</rdfs:label>
    <rdfs:label xml:lang="de">Adresszuordnung</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb7"/>
    <rdfs:subClassOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb8"/>
    <rdfs:subClassOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb9"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb1">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:email rdf:resource="mailto:sven.zentgraf@rub.de"/>
    <schema:identifier rdf:resource="https://orcid.org/0000-0001-6058-7614"/>
    <schema:memberOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb2"/>
    <schema:name>Sven Zentgraf</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#postalCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Postleitzahl oder vergleichbare postalische Gebietskennung.</rdfs:comment>
    <rdfs:comment xml:lang="en">Postal code or comparable postal area identifier.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">postal code</rdfs:label>
    <rdfs:label xml:lang="de">Postleitzahl</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://www.construct-x.org/ontology/address#assignedAddress"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#attentionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Empfängerhinweis im Sinn von „zu Händen“.</rdfs:comment>
    <rdfs:comment xml:lang="en">Addressee instruction in the sense of 'for the attention of'.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#AddressAssignment"/>
    <rdfs:label xml:lang="en">attention of</rdfs:label>
    <rdfs:label xml:lang="de">zu Händen</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb11">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb12"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://www.construct-x.org/ontology/address#careOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb12">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:rest rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb13"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#hasGeographicPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknüpft eine Adresse optional mit einer Position aus einem externen Geomodell. Der Wertebereich bleibt in Version 0.1.0 bewusst offen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Optionally links an address to a position from an external geographic model. The range intentionally remains open in version 0.1.0.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">has geographic position</rdfs:label>
    <rdfs:label xml:lang="de">hat geografische Position</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#broaderAdministrativeTerritory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknüpft eine Verwaltungseinheit mit dem direkt übergeordneten administrativen Gebiet oder Land.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an administrative area to its directly broader administrative territory or country.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#AdministrativeArea"/>
    <rdfs:label xml:lang="en">broader administrative territory</rdfs:label>
    <rdfs:label xml:lang="de">übergeordnetes administratives Gebiet</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/address#AdministrativeTerritory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#citySubdivisionName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Name eines Stadt-, Orts- oder Gemeindeteils.</rdfs:comment>
    <rdfs:comment xml:lang="en">Name of a city, locality, or municipal subdivision.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">city subdivision name</rdfs:label>
    <rdfs:label xml:lang="de">Stadtteilname</rdfs:label>
    <rdfs:range rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb38"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#buildingName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Eigenname oder gebräuchliche Bezeichnung eines Gebäudes.</rdfs:comment>
    <rdfs:comment xml:lang="en">Proper or commonly used name of a building.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">building name</rdfs:label>
    <rdfs:label xml:lang="de">Gebäudename</rdfs:label>
    <rdfs:range rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb20"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#AdministrativeArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Eine Verwaltungseinheit unterhalb eines Landes oder einer anderen Verwaltungseinheit, beispielsweise ein Bundesland, eine Provinz, ein Landkreis oder eine Kommune.</rdfs:comment>
    <rdfs:comment xml:lang="en">An administrative unit below a country or another administrative unit, such as a state, province, district, or municipality.</rdfs:comment>
    <rdfs:label xml:lang="en">Administrative area</rdfs:label>
    <rdfs:label xml:lang="de">Verwaltungseinheit</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/address#AdministrativeTerritory"/>
    <rdfs:subClassOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#hasAddressAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknüpft eine beliebige identifizierbare Ressource mit einer kontextbezogenen Adresszuordnung.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links any identifiable resource to a contextual address assignment.</rdfs:comment>
    <rdfs:label xml:lang="en">has address assignment</rdfs:label>
    <rdfs:label xml:lang="de">hat Adresszuordnung</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/address#AddressAssignment"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    <owl:onProperty rdf:resource="https://www.construct-x.org/ontology/address#addressRole"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://www.construct-x.org/ontology/address#broaderAdministrativeTerritory"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb37">
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb21">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:rest rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb22"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#Country">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Ein souveränes oder in einem maßgeblichen Referenzsystem als Land geführtes Gebiet.</rdfs:comment>
    <rdfs:comment xml:lang="en">A territory regarded as a country by an authoritative reference system or through sovereignty.</rdfs:comment>
    <rdfs:label xml:lang="en">Country</rdfs:label>
    <rdfs:label xml:lang="de">Land</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/address#AdministrativeTerritory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#hasAdministrativeArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verweist auf eine für die Adresse relevante Verwaltungseinheit.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an address to a relevant administrative area.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">has administrative area</rdfs:label>
    <rdfs:label xml:lang="de">hat Verwaltungseinheit</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/address#AdministrativeArea"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#buildingPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Bezeichnung eines Gebäudeteils, beispielsweise Bauteil, Trakt, Flügel oder Halle.</rdfs:comment>
    <rdfs:comment xml:lang="en">Designation of a building part, such as a section, wing, tract, or hall.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">building part</rdfs:label>
    <rdfs:label xml:lang="de">Gebäudeteil</rdfs:label>
    <rdfs:range rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb23"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#internalDeliveryPoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Stabile interne Zustellstelle innerhalb eines Gebäudes oder Betriebsgeländes.</rdfs:comment>
    <rdfs:comment xml:lang="en">Stable internal delivery point within a building or operating site.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/address#Address"/>
    <rdfs:label xml:lang="en">internal delivery point</rdfs:label>
    <rdfs:label xml:lang="de">interne Zustellstelle</rdfs:label>
    <rdfs:range rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb32"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb14">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb15"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/address#Address">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Eine strukturierte Zusammenstellung von Angaben, mit denen ein postalischer oder physischer Adressbezug beschrieben wird.</rdfs:comment>
    <rdfs:comment xml:lang="en">A structured set of information describing a postal or physical address reference.</rdfs:comment>
    <rdfs:label xml:lang="en">Address</rdfs:label>
    <rdfs:label xml:lang="de">Adresse</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb3"/>
    <rdfs:subClassOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb4"/>
    <rdfs:subClassOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb5"/>
    <rdfs:subClassOf rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb6"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb15">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:rest rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb16"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na9bdeb08469b4e8480cea14ec0e3a2bcb40">
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
