<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema="https://schema.org/"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:nodeID="n8684dcd3c24d43ce92b19f3963bbec1db2">
    <schema:identifier rdf:resource="https://www.inf.bi.ruhr-uni-bochum.de/iib/lehrstuhl/mitarbeiter/sven_zentgraf.html.en"/>
    <schema:name>Ruhr University Bochum</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/participation#context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Bestimmt die fachliche Ressource, gegenueber der die Rollenzuordnung gilt. Der Kontexttyp bleibt bewusst offen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Specifies the domain resource in relation to which the role assignment applies. The context type deliberately remains open.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/participation#Participation"/>
    <rdfs:label xml:lang="en">context</rdfs:label>
    <rdfs:label xml:lang="de">Kontext</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/participation#endDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Datum, bis zu dem die durch die Participation beschriebene Rollenzuordnung gilt oder galt.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date until which the role assignment described by the Participation applies or applied.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/participation#Participation"/>
    <rdfs:label xml:lang="en">end date</rdfs:label>
    <rdfs:label xml:lang="de">Enddatum</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/participation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:bibliographicCitation xml:lang="en">Construct-X Participation Ontology, version 0.2.0</dcterms:bibliographicCitation>
    <dcterms:bibliographicCitation xml:lang="de">Construct-X Participation-Ontologie, Version 0.2.0</dcterms:bibliographicCitation>
    <dcterms:contributor xml:lang="de">Construction-X Arbeitspaket 3.4</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</dcterms:created>
    <dcterms:creator rdf:nodeID="n8684dcd3c24d43ce92b19f3963bbec1db1"/>
    <dcterms:description xml:lang="de">Definiert eine allgemeine qualifizierte Zuordnung genau eines Agenten zu genau einer Rolle in genau einem fachlichen Kontext.</dcterms:description>
    <dcterms:description xml:lang="en">Defines a general qualified assignment of exactly one agent to exactly one role in exactly one domain context.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-07</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.construct-x.org/id/organization/ecbe8336-94ab-5c11-8220-94f260963eb2/revision/1"/>
    <dcterms:source rdf:resource="https://www.w3.org/TR/swbp-n-aryRelations/"/>
    <dcterms:source rdf:resource="https://www.w3.org/TR/vocab-org/"/>
    <dcterms:source rdf:resource="https://www.w3.org/TR/skos-reference/"/>
    <dcterms:title xml:lang="en">Construct-X Participation Ontology</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X Participation-Ontologie</dcterms:title>
    <vann:preferredNamespacePrefix>conx-part</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/ontology/participation#</vann:preferredNamespaceUri>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/ontology/participation/0.2.0"/>
    <owl:versionInfo>0.2.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/participation#role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Bestimmt die genau eine kontrollierte Rolle des Agenten innerhalb der Participation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Specifies the single controlled role of the agent within the Participation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/participation#Participation"/>
    <rdfs:label xml:lang="en">role</rdfs:label>
    <rdfs:label xml:lang="de">Rolle</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/participation#Role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/participation#Participation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Tatsaechlich geltende oder historisch gegoltene Zuordnung genau eines Agenten zu genau einer Rolle in genau einem fachlichen Kontext.</rdfs:comment>
    <rdfs:comment xml:lang="en">An actually applicable or historically applicable assignment of exactly one agent to exactly one role in exactly one domain context.</rdfs:comment>
    <rdfs:label xml:lang="de">Beteiligung</rdfs:label>
    <rdfs:label xml:lang="en">Participation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/participation#hasParticipation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="de">hat Beteiligung</rdfs:label>
    <rdfs:label xml:lang="en">has participation</rdfs:label>
    <rdfs:comment xml:lang="de">Verknüpft einen fachlichen Kontext mit einer Beteiligungsinstanz, nicht unmittelbar mit einem Agenten. Optionale Navigation in Gegenrichtung zu context.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a domain context to a participation instance, not directly to an agent. Optional navigation in the inverse direction of context.</rdfs:comment>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/participation#Participation"/>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/participation#context"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/participation#participant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Bestimmt den Agenten, dessen Rolle durch die Participation beschrieben wird.</rdfs:comment>
    <rdfs:comment xml:lang="en">Specifies the agent whose role is described by the Participation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/participation#Participation"/>
    <rdfs:label xml:lang="en">participant</rdfs:label>
    <rdfs:label xml:lang="de">beteiligter Agent</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/agent#Agent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/participation#startDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Datum, ab dem die durch die Participation beschriebene Rollenzuordnung gilt oder galt.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date from which the role assignment described by the Participation applies or applied.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/participation#Participation"/>
    <rdfs:label xml:lang="en">start date</rdfs:label>
    <rdfs:label xml:lang="de">Startdatum</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/participation#Role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Kontrollierte Funktion, die ein Agent innerhalb einer Participation gegenueber einem fachlichen Kontext einnimmt. Konkrete Rollen werden als Referenzdaten ausserhalb der T-Box gepflegt.</rdfs:comment>
    <rdfs:comment xml:lang="en">Controlled function held by an agent within a Participation in relation to a domain context. Concrete roles are maintained as reference data outside the T-Box.</rdfs:comment>
    <rdfs:label xml:lang="en">Role</rdfs:label>
    <rdfs:label xml:lang="de">Rolle</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8684dcd3c24d43ce92b19f3963bbec1db1">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:email rdf:resource="mailto:sven.zentgraf@rub.de"/>
    <schema:identifier rdf:resource="https://orcid.org/0000-0001-6058-7614"/>
    <schema:memberOf rdf:nodeID="n8684dcd3c24d43ce92b19f3963bbec1db2"/>
    <schema:name>Sven Zentgraf</schema:name>
  </rdf:Description>
</rdf:RDF>
