<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema="https://schema.org/"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Allgemein verwendbare Bezeichnung einer Organisation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Generally usable name of an Organization.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:label xml:lang="de">Bezeichnung</rdfs:label>
    <rdfs:range rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb3"/>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/name"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#OrganizationalUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Ein organisatorischer Teil einer oder mehrerer übergeordneter Organisationen mit eigener Funktion oder Zuständigkeit, aber ohne daraus abgeleitete eigene Rechtspersönlichkeit.</rdfs:comment>
    <rdfs:comment xml:lang="en">An organizational part of one or more parent organizations with its own function or responsibility, but without a separate legal identity being implied.</rdfs:comment>
    <rdfs:label xml:lang="de">Organisationseinheit</rdfs:label>
    <rdfs:label xml:lang="en">Organizational Unit</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#Membership">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Eine eigenständige Beziehung, durch die genau ein Agent Mitglied genau einer Organisation ist. Rolle und Gültigkeitszeitraum gehören nicht zum MVP.</rdfs:comment>
    <rdfs:comment xml:lang="en">A standalone relationship through which exactly one Agent is a member of exactly one Organization. Role and validity period are outside the MVP.</rdfs:comment>
    <rdfs:label xml:lang="de">Mitgliedschaft</rdfs:label>
    <rdfs:label xml:lang="en">Membership</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Membership"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#member">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Bestimmt den Agenten, der Subjekt einer Mitgliedschaft ist.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifies the Agent that is the subject of a Membership.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#Membership"/>
    <rdfs:label xml:lang="en">member</rdfs:label>
    <rdfs:label xml:lang="de">Mitglied</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/agent#Agent"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/org#member"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#hasSubOrganization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknüpft eine Organisation mit einer ihr organisatorisch untergeordneten Organisation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an Organization to an organizationally subordinate Organization.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:label xml:lang="en">has sub-organization</rdfs:label>
    <rdfs:label xml:lang="de">hat Unterorganisation</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/org#hasSubOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#unitOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Ordnet eine Organisationseinheit einer übergeordneten Organisation zu. Mehrere Zuordnungen sind für Matrixorganisationen möglich.</rdfs:comment>
    <rdfs:comment xml:lang="en">Assigns an Organizational Unit to a parent Organization. Multiple assignments are possible for matrix organizations.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#OrganizationalUnit"/>
    <rdfs:label xml:lang="en">unit of</rdfs:label>
    <rdfs:label xml:lang="de">Einheit von</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/org#unitOf"/>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/organization#hasUnit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#membershipOrganization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Bestimmt die Organisation, in der eine Mitgliedschaft besteht.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifies the Organization in which a Membership exists.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#Membership"/>
    <rdfs:label xml:lang="en">membership organization</rdfs:label>
    <rdfs:label xml:lang="de">Mitgliedschaftsorganisation</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/org#organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#representedOrganization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Bestimmt die Legal Entity, auf die sich eine rechtliche Vertretungsbeziehung bezieht.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifies the Legal Entity to which a legal representation relationship applies.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#LegalRepresentation"/>
    <rdfs:label xml:lang="en">represented organization</rdfs:label>
    <rdfs:label xml:lang="de">vertretene Organisation</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/organization#LegalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#LegalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Eine Organisation mit eigenständiger rechtlicher Identität, die im relevanten Rechtsraum als Träger von Rechten und Pflichten behandelt wird.</rdfs:comment>
    <rdfs:comment xml:lang="en">An organization with a separate legal identity that is treated as a bearer of rights and obligations in the relevant jurisdiction.</rdfs:comment>
    <rdfs:label xml:lang="de">Rechtliche Einheit</rdfs:label>
    <rdfs:label xml:lang="en">Legal Entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#subOrganizationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Ordnet eine Organisation einer übergeordneten Organisation in einer allgemeinen Organisationshierarchie unter, ohne Eigentum oder Kontrolle zu behaupten.</rdfs:comment>
    <rdfs:comment xml:lang="en">Assigns an Organization to a parent Organization in a general organizational hierarchy without asserting ownership or control.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:label xml:lang="en">sub-organization of</rdfs:label>
    <rdfs:label xml:lang="de">Unterorganisation von</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/org#subOrganizationOf"/>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/organization#hasSubOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#registrationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Kalenderdatum, an dem eine Legal Entity im maßgeblichen Register registriert wurde. Es ist nicht automatisch das Gründungsdatum oder der Beginn der Geschäftstätigkeit.</rdfs:comment>
    <rdfs:comment xml:lang="en">Calendar date on which a Legal Entity was registered in the relevant register. It is not automatically the founding date or the start of business activity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#LegalEntity"/>
    <rdfs:label xml:lang="en">registration date</rdfs:label>
    <rdfs:label xml:lang="de">Registrierungsdatum</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknüpft eine Organisation mit einem kontrolliert klassifizierten Tätigkeitsbereich.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an Organization to a controlled activity classification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:label xml:lang="en">activity</rdfs:label>
    <rdfs:label xml:lang="de">Tätigkeit</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:bibliographicCitation xml:lang="en">Construct-X Organization Ontology, version 0.1.0</dcterms:bibliographicCitation>
    <dcterms:bibliographicCitation xml:lang="de">Construct-X Organisationsontologie, Version 0.1.0</dcterms:bibliographicCitation>
    <dcterms:contributor xml:lang="de">Construction-X Arbeitspaket 3.4</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</dcterms:created>
    <dcterms:creator rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb1"/>
    <dcterms:description xml:lang="de">Definiert den fachlichen Kern für Organisationen, rechtliche Einheiten, Organisationseinheiten, Mitgliedschaften und rechtliche Vertretungen im Construct-X-Ontologienetzwerk.</dcterms:description>
    <dcterms:description xml:lang="en">Defines the domain core for organizations, legal entities, organizational units, memberships, and legal representations in the Construct-X ontology network.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.construct-x.org/id/organization/ecbe8336-94ab-5c11-8220-94f260963eb2/revision/1"/>
    <dcterms:source rdf:resource="https://www.w3.org/TR/vocab-org/"/>
    <dcterms:source rdf:resource="https://semiceu.github.io/Core-Business-Vocabulary/releases/2.3.0/"/>
    <dcterms:source rdf:resource="https://docs.oasis-open.org/ubl/cs01-UBL-2.5/"/>
    <dcterms:source rdf:resource="https://schema.org/Organization"/>
    <dcterms:title xml:lang="en">Construct-X Organization Ontology</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X Organisationsontologie</dcterms:title>
    <vann:preferredNamespacePrefix>conx-org</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/ontology/organization#</vann:preferredNamespaceUri>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/ontology/organization/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#hasUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknüpft eine Organisation mit einer enthaltenen Organisationseinheit.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an Organization to a contained Organizational Unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:label xml:lang="en">has unit</rdfs:label>
    <rdfs:label xml:lang="de">hat Organisationseinheit</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/organization#OrganizationalUnit"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/org#hasUnit"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb1">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:email rdf:resource="mailto:sven.zentgraf@rub.de"/>
    <schema:identifier rdf:resource="https://orcid.org/0000-0001-6058-7614"/>
    <schema:memberOf rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb2"/>
    <schema:name>Sven Zentgraf</schema:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb9">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb6">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#alternativeName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Weitere gebräuchliche Bezeichnung, Kurzform oder Handelsname einer Organisation.</rdfs:comment>
    <rdfs:comment xml:lang="en">Alternative commonly used name, abbreviation, or trade name of an Organization.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#Organization"/>
    <rdfs:label xml:lang="en">alternative name</rdfs:label>
    <rdfs:label xml:lang="de">alternative Bezeichnung</rdfs:label>
    <rdfs:range rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb9"/>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/alternateName"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb2">
    <schema:identifier rdf:resource="https://www.inf.bi.ruhr-uni-bochum.de/iib/lehrstuhl/mitarbeiter/sven_zentgraf.html.en"/>
    <schema:name>Ruhr University Bochum</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#legalForm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknüpft eine Legal Entity mit einer kontrolliert beschriebenen Rechtsform.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a Legal Entity to a controlled legal-form concept.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#LegalEntity"/>
    <rdfs:label xml:lang="en">legal form</rdfs:label>
    <rdfs:label xml:lang="de">Rechtsform</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#representative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Bestimmt die Person, die eine Legal Entity rechtlich vertritt.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifies the Person who legally represents a Legal Entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#LegalRepresentation"/>
    <rdfs:label xml:lang="en">representative</rdfs:label>
    <rdfs:label xml:lang="de">vertretende Person</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/person#Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb7">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:rest rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#legalName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Rechtlich beziehungsweise registeramtlich geführter Name einer Legal Entity.</rdfs:comment>
    <rdfs:comment xml:lang="en">Legal or officially registered name of a Legal Entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/organization#LegalEntity"/>
    <rdfs:label xml:lang="en">legal name</rdfs:label>
    <rdfs:label xml:lang="de">rechtlicher Name</rdfs:label>
    <rdfs:range rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb6"/>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/legalName"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb4">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:rest rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb5">
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Ein organisierter kollektiver Akteur mit einem gemeinsamen Zweck oder einer dauerhaft erkennbaren Struktur. Die Klasse behauptet weder eigene Rechtspersönlichkeit noch eine bestimmte wirtschaftliche Rolle.</rdfs:comment>
    <rdfs:comment xml:lang="en">An organized collective agent with a common purpose or a persistently recognizable structure. The class asserts neither separate legal personality nor a particular economic role.</rdfs:comment>
    <rdfs:label xml:lang="de">Organisation</rdfs:label>
    <rdfs:label xml:lang="en">Organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/agent#Agent"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/organization#LegalRepresentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Eine rechtliche Vertretungsbeziehung zwischen einer Legal Entity und einer Person. Personendaten werden nicht in der Beziehung dupliziert.</rdfs:comment>
    <rdfs:comment xml:lang="en">A legal representation relationship between a Legal Entity and a Person. Personal data is not duplicated in the relationship.</rdfs:comment>
    <rdfs:label xml:lang="de">Rechtliche Vertretung</rdfs:label>
    <rdfs:label xml:lang="en">Legal Representation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb8">
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb10">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:rest rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb11"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb3">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ncf3839b21b634c22ae9ceb8d09a8e43fb11">
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
</rdf:RDF>
