<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema="https://schema.org/"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Dokumentversion oder fachliche Ausgabebezeichnung als Textwert.</rdfs:comment>
    <rdfs:comment xml:lang="en">Document version or semantic edition designation expressed as text.</rdfs:comment>
    <rdfs:label xml:lang="en">version</rdfs:label>
    <rdfs:label xml:lang="de">Version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/version"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b15">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b16"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b13">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdf:rest rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#hasDistribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknuepft ein Dokument oder eine Dokumentreferenz mit einer technischen Distribution. Die Property besitzt bewusst keine harte RDFS-Domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a document or document reference to a technical distribution. The property deliberately has no hard RDFS domain.</rdfs:comment>
    <rdfs:label xml:lang="en">has distribution</rdfs:label>
    <rdfs:label xml:lang="de">hat Distribution</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/document#DocumentDistribution"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/dcat#distribution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:bibliographicCitation xml:lang="en">Construct-X Document Ontology, version 0.1.0</dcterms:bibliographicCitation>
    <dcterms:bibliographicCitation xml:lang="de">Construct-X Dokumentontologie, Version 0.1.0</dcterms:bibliographicCitation>
    <dcterms:contributor xml:lang="de">Construction-X Arbeitspaket 3.4</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</dcterms:created>
    <dcterms:creator rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b1"/>
    <dcterms:description xml:lang="de">Definiert den fachlichen Kern fuer Dokumente, kontextbezogene Dokumentreferenzen, technische Distributionen sowie kontrollierte Dokumenttypen und Dokumentstatus im Construct-X-Ontologienetzwerk.</dcterms:description>
    <dcterms:description xml:lang="en">Defines the semantic core for documents, contextual document references, technical distributions, and controlled document types and statuses in the Construct-X ontology network.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.construct-x.org/id/organization/ecbe8336-94ab-5c11-8220-94f260963eb2/revision/1"/>
    <dcterms:source rdf:resource="https://www.dublincore.org/specifications/dublin-core/dcmi-terms/"/>
    <dcterms:source rdf:resource="https://www.w3.org/TR/vocab-dcat-3/"/>
    <dcterms:source rdf:resource="https://schema.org/DigitalDocument"/>
    <dcterms:source rdf:resource="https://xmlns.com/foaf/spec/"/>
    <dcterms:source rdf:resource="https://docs.oasis-open.org/ubl/cs01-UBL-2.5/"/>
    <dcterms:title xml:lang="en">Construct-X Document Ontology</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X Dokumentontologie</dcterms:title>
    <vann:preferredNamespacePrefix>conx-doc</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/ontology/document#</vann:preferredNamespaceUri>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/ontology/document/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b11">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#validFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Optionaler Beginn der fachlichen Gueltigkeit eines Dokuments.</rdfs:comment>
    <rdfs:comment xml:lang="en">Optional start of the semantic validity of a document.</rdfs:comment>
    <rdfs:label xml:lang="en">valid from</rdfs:label>
    <rdfs:label xml:lang="de">gueltig ab</rdfs:label>
    <rdfs:range rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b18"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/valid"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/validFrom"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b23">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#issued">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Datum oder Zeitpunkt, an dem das Dokument fachlich ausgestellt oder ausgegeben wurde.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date or point in time when the document was semantically issued.</rdfs:comment>
    <rdfs:label xml:lang="en">issued</rdfs:label>
    <rdfs:label xml:lang="de">ausgegeben</rdfs:label>
    <rdfs:range rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b12"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/issued"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Anzeigename oder fachlicher Titel eines Dokuments oder einer Dokumentreferenz.</rdfs:comment>
    <rdfs:comment xml:lang="en">Display name or semantic title of a document or document reference.</rdfs:comment>
    <rdfs:label xml:lang="en">title</rdfs:label>
    <rdfs:label xml:lang="de">Titel</rdfs:label>
    <rdfs:range rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b3"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/title"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/name"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#documentStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Weist einem Dokument einen kontrollierten dokumentbezogenen Zustand zu. Die Property beschreibt keinen Workflow- oder Bearbeitungsstatus.</rdfs:comment>
    <rdfs:comment xml:lang="en">Assigns a controlled document-related state to a document. The property does not describe workflow or processing status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/document#Document"/>
    <rdfs:label xml:lang="en">document status</rdfs:label>
    <rdfs:label xml:lang="de">Dokumentstatus</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/document#DocumentStatus"/>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/adms#status"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/creativeWorkStatus"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#referencesDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknuepft eine Dokumentreferenz mit einem im Graph als Construct-X-Dokument modellierten Informationsobjekt. Fuer nur extern identifizierte Ressourcen kann dcterms:references verwendet werden.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a document reference to an information object modeled as a Construct-X Document in the graph. Dcterms:references may be used for resources identified only externally.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/document#DocumentReference"/>
    <rdfs:label xml:lang="en">references document</rdfs:label>
    <rdfs:label xml:lang="de">referenziert Dokument</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/document#Document"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/references"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#modified">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Datum oder Zeitpunkt der letzten bekannten inhaltlichen Aenderung des Dokuments.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date or point in time of the last known content modification of the document.</rdfs:comment>
    <rdfs:label xml:lang="en">modified</rdfs:label>
    <rdfs:label xml:lang="de">geaendert</rdfs:label>
    <rdfs:range rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b15"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/modified"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/dateModified"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Freitextbeschreibung eines Dokuments oder einer Dokumentreferenz.</rdfs:comment>
    <rdfs:comment xml:lang="en">Free-text description of a document or document reference.</rdfs:comment>
    <rdfs:label xml:lang="en">description</rdfs:label>
    <rdfs:label xml:lang="de">Beschreibung</rdfs:label>
    <rdfs:range rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b6"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/description"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/description"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b7">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:rest rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#DocumentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Kontrollierter Typ eines Dokuments oder einer Dokumentreferenz. Freigegebene Werte werden im Document-Type-Referenzvokabular gepflegt.</rdfs:comment>
    <rdfs:comment xml:lang="en">Controlled type of a document or document reference. Approved values are maintained in the Document Type reference vocabulary.</rdfs:comment>
    <rdfs:label xml:lang="en">Document type</rdfs:label>
    <rdfs:label xml:lang="de">Dokumenttyp</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b8">
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#language">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Sprache des Dokumentinhalts, vorzugsweise als BCP-47-Sprachkennzeichnung.</rdfs:comment>
    <rdfs:comment xml:lang="en">Language of the document content, preferably expressed as a BCP 47 language tag.</rdfs:comment>
    <rdfs:label xml:lang="en">language</rdfs:label>
    <rdfs:label xml:lang="de">Sprache</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/language"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/inLanguage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#fileName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Name einer konkreten Datei, die durch eine Dokumentdistribution beschrieben wird.</rdfs:comment>
    <rdfs:comment xml:lang="en">Name of a concrete file described by a document distribution.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/document#DocumentDistribution"/>
    <rdfs:label xml:lang="en">file name</rdfs:label>
    <rdfs:label xml:lang="de">Dateiname</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#hasDocumentReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Verknuepft eine fachliche Kontextressource mit einer eigenstaendigen Dokumentreferenz. Die Property besitzt bewusst keine harte RDFS-Domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a contextual resource to a standalone document reference. The property deliberately has no hard RDFS domain.</rdfs:comment>
    <rdfs:label xml:lang="en">has document reference</rdfs:label>
    <rdfs:label xml:lang="de">hat Dokumentreferenz</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/document#DocumentReference"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#DocumentDistribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Eine konkrete technische Auspraegung oder Bereitstellung eines Dokuments, beispielsweise als PDF-, XML- oder HTML-Ressource. Die Klasse beschreibt weder Speicherortverwaltung noch Archivierung.</rdfs:comment>
    <rdfs:comment xml:lang="en">A concrete technical representation or distribution of a document, for example as a PDF, XML, or HTML resource. The class describes neither storage management nor archiving.</rdfs:comment>
    <rdfs:label xml:lang="en">Document distribution</rdfs:label>
    <rdfs:label xml:lang="de">Dokumentdistribution</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b22">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdf:rest rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b23"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b14">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#validUntil">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Optionales Ende der fachlichen Gueltigkeit eines Dokuments.</rdfs:comment>
    <rdfs:comment xml:lang="en">Optional end of the semantic validity of a document.</rdfs:comment>
    <rdfs:label xml:lang="en">valid until</rdfs:label>
    <rdfs:label xml:lang="de">gueltig bis</rdfs:label>
    <rdfs:range rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b21"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/valid"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/validThrough"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#Document">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Ein dokumentartiges Informationsobjekt, das unabhaengig von einer konkreten Datei oder technischen Bereitstellung beschrieben und identifiziert werden kann.</rdfs:comment>
    <rdfs:comment xml:lang="en">A document-like information object that can be described and identified independently of a concrete file or technical distribution.</rdfs:comment>
    <rdfs:label xml:lang="en">Document</rdfs:label>
    <rdfs:label xml:lang="de">Dokument</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
    <rdfs:seeAlso rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/DigitalDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#DocumentStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Kontrollierter dokumentbezogener Zustand. Freigegebene Werte werden im Document-Status-Referenzvokabular gepflegt; Workflowzustaende sind ausgeschlossen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Controlled document-related state. Approved values are maintained in the Document Status reference vocabulary; workflow states are excluded.</rdfs:comment>
    <rdfs:label xml:lang="en">Document status</rdfs:label>
    <rdfs:label xml:lang="de">Dokumentstatus</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b1">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:email rdf:resource="mailto:sven.zentgraf@rub.de"/>
    <schema:identifier rdf:resource="https://orcid.org/0000-0001-6058-7614"/>
    <schema:memberOf rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b2"/>
    <schema:name>Sven Zentgraf</schema:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b6">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#created">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="de">Datum oder Zeitpunkt, an dem das Dokument erzeugt wurde.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date or point in time when the document was created.</rdfs:comment>
    <rdfs:label xml:lang="en">created</rdfs:label>
    <rdfs:label xml:lang="de">erstellt</rdfs:label>
    <rdfs:range rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b9"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/created"/>
    <rdfs:seeAlso rdf:resource="https://schema.org/dateCreated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#documentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="de">Weist einem Dokument oder einer Dokumentreferenz einen kontrollierten Dokumenttyp zu. Die Property besitzt bewusst keine harte RDFS-Domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">Assigns a controlled document type to a document or document reference. The property deliberately has no hard RDFS domain.</rdfs:comment>
    <rdfs:label xml:lang="en">document type</rdfs:label>
    <rdfs:label xml:lang="de">Dokumenttyp</rdfs:label>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/document#DocumentType"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/type"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b19">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdf:rest rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b20"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b4">
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:rest rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b12">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <owl:unionOf rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b13"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfa49c3e5f5b1459bb93b689f2fb307b1b2">
    <schema:identifier rdf:resource="https://www.inf.bi.ruhr-uni-bochum.de/iib/lehrstuhl/mitarbeiter/sven_zentgraf.html.en"/>
    <schema:name>Ruhr University Bochum</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/document#DocumentReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Eine eigenstaendige, kontextbezogene Bezugnahme auf ein Dokument, eine externe Dokumentressource oder eine technische Distribution.</rdfs:comment>
