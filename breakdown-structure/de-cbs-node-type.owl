  <rdf:Description rdf:about="https://www.construct-x.org/vocab/breakdown-structure/de-cbs-node-type">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/vocab/breakdown-structure/de-cbs-node-type/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <dcterms:title xml:lang="en">Construct-X DE CBS Node Type Vocabulary</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X-DE-Vokabular für CBS-Knotentypen</dcterms:title>
    <dcterms:description xml:lang="en">Germany-specific controlled vocabulary for semantic node types of Cost Breakdown Structures (CBS). The current concepts represent first-level cost groups according to DIN 276:2018-12.</dcterms:description>
    <dcterms:description xml:lang="de">Deutschland-spezifisches kontrolliertes Vokabular für fachliche Knotentypen von Cost Breakdown Structures (CBS). Die aktuellen Konzepte bilden Kostengruppen der ersten Ebene nach DIN 276:2018-12 ab.</dcterms:description>
    <dcterms:publisher rdf:resource="https://www.construct-x.org/id/organization/construct-x"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-21</dcterms:modified>
    <dcterms:source>DIN 276:2018-12, 5.1</dcterms:source>
