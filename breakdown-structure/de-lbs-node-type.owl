    <dcterms:description xml:lang="en">Germany-specific controlled vocabulary for semantic node types of Location Breakdown Structures (LBS), based on the supplied classification excerpt GR51 / M270-M283.</dcterms:description>
    <dcterms:description xml:lang="de">Deutschland-spezifisches kontrolliertes Vokabular für fachliche Knotentypen von Location Breakdown Structures (LBS), basierend auf dem bereitgestellten Klassifikationsauszug GR51 / M270-M283.</dcterms:description>
    <dcterms:publisher rdf:resource="https://www.construct-x.org/id/organization/construct-x"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-21</dcterms:modified>
    <dcterms:source>Provided classification excerpt: GR51 Location Breakdown; M270-M283.</dcterms:source>
    <vann:preferredNamespacePrefix>conx-de-lbs</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/vocab/breakdown-structure/de-lbs-node-type#</vann:preferredNamespaceUri>
  </rdf:Description>
