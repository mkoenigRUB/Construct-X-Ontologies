<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#WorkBreakdownStructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownStructure"/>
    <rdfs:label xml:lang="en">Work Breakdown Structure</rdfs:label>
    <skos:altLabel xml:lang="de">Projektstrukturplan (PSP)</skos:altLabel>
    <skos:altLabel xml:lang="de">Work Breakdown Structure (WBS)</skos:altLabel>
    <rdfs:comment xml:lang="en">A hierarchical decomposition of the defined project scope into progressively more detailed work-scope elements. It describes what work is structured, not where the work is performed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#hasNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownStructure"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:label xml:lang="en">has node</rdfs:label>
    <skos:altLabel xml:lang="de">enthält Knoten</skos:altLabel>
    <rdfs:comment xml:lang="en">Associates a Breakdown Structure with one of its nodes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#CostBreakdownStructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownStructure"/>
    <rdfs:label xml:lang="en">Cost Breakdown Structure</rdfs:label>
    <skos:altLabel xml:lang="de">Kostengliederungsstruktur</skos:altLabel>
    <skos:altLabel xml:lang="de">Cost Breakdown (CBS)</skos:altLabel>
    <rdfs:comment xml:lang="en">A hierarchical decomposition used to structure project costs according to a selected cost classification or project-specific cost scheme.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#LocationBreakdownStructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownStructure"/>
    <rdfs:label xml:lang="en">Location Breakdown Structure</rdfs:label>
    <skos:altLabel xml:lang="de">räumliche Gliederungsstruktur (LBS)</skos:altLabel>
    <skos:altLabel xml:lang="de">Ortsstruktur (LBS)</skos:altLabel>
    <rdfs:comment xml:lang="en">A hierarchical decomposition of a project into physical or logical location categories used for planning and execution.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b5">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#CostBreakdownStructure"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#isSubNodeOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#hasSubNode"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:label xml:lang="en">is sub-node of</rdfs:label>
    <skos:altLabel xml:lang="de">ist untergeordneter Knoten von</skos:altLabel>
    <rdfs:comment xml:lang="en">Relates a Breakdown Node to its direct parent node.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b12"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#BreakdownStructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Breakdown Structure</rdfs:label>
    <skos:altLabel xml:lang="de">Gliederungsstruktur</skos:altLabel>
    <rdfs:comment xml:lang="en">A hierarchical structure that decomposes a defined subject into progressively more detailed nodes.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#SystemBreakdownStructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownStructure"/>
    <rdfs:label xml:lang="en">System Breakdown Structure</rdfs:label>
    <skos:altLabel xml:lang="de">Systemgliederungsstruktur</skos:altLabel>
    <skos:altLabel xml:lang="de">System Breakdown (SBS)</skos:altLabel>
    <rdfs:comment xml:lang="en">A hierarchical decomposition of a project or asset according to systems, system types, assemblies, elements or components.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#hasRootNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#hasNode"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownStructure"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:label xml:lang="en">has root node</rdfs:label>
    <skos:altLabel xml:lang="de">hat Wurzelknoten</skos:altLabel>
    <rdfs:comment xml:lang="en">Associates a Breakdown Structure with a node that has no parent node within that structure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/ontology/breakdown-structure/0.7.0"/>
    <owl:versionInfo>0.7.0</owl:versionInfo>
    <dcterms:title xml:lang="en">Construct-X Breakdown Structure Ontology</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X-Ontologie für Gliederungsstrukturen</dcterms:title>
    <dcterms:description xml:lang="en">Defines reusable Work, Location, System and Cost Breakdown Structures and their hierarchy nodes.</dcterms:description>
    <dcterms:description xml:lang="de">Definiert wiederverwendbare Arbeits-, Orts-, System- und Kostengliederungsstrukturen sowie deren Hierarchieknoten.</dcterms:description>
    <dcterms:publisher rdf:resource="https://www.construct-x.org/id/organization/construct-x"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-21</dcterms:modified>
    <vann:preferredNamespacePrefix>conx-bs</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/ontology/breakdown-structure#</vann:preferredNamespaceUri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#level">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:label xml:lang="en">level</rdfs:label>
    <skos:altLabel xml:lang="de">Ebene</skos:altLabel>
    <rdfs:comment xml:lang="en">Optional numeric hierarchy level. Explicit parent-child relations remain authoritative.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#nodeType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">node type</rdfs:label>
    <skos:altLabel xml:lang="de">Knotentyp</skos:altLabel>
    <rdfs:comment xml:lang="en">Associates a Breakdown Node with a controlled concept that describes the semantic type of the node, for example Storey, Trade, Component Type or Cost Group 300. The concrete allowed vocabulary is selected by optional SHACL profiles.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verknüpft einen Gliederungsknoten mit einem kontrollierten Konzept, das den fachlichen Typ des Knotens beschreibt, zum Beispiel Geschoss, Gewerk, Komponententyp oder Kostengruppe 300. Das konkret zulässige Vokabular wird über optionale SHACL-Profile festgelegt.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#LBSNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:label xml:lang="en">LBS Node</rdfs:label>
    <skos:altLabel xml:lang="de">LBS-Knoten</skos:altLabel>
    <rdfs:comment xml:lang="en">A Breakdown Node that belongs to a Location Breakdown Structure and represents a location category or hierarchy element.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#code">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">code</rdfs:label>
    <skos:altLabel xml:lang="de">Code</skos:altLabel>
    <rdfs:comment xml:lang="en">Optional domain or classification code of a Breakdown Node.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#hasSubNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:label xml:lang="en">has sub-node</rdfs:label>
    <skos:altLabel xml:lang="de">hat untergeordneten Knoten</skos:altLabel>
    <rdfs:comment xml:lang="en">Inverse relation of isSubNodeOf.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b15"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#WBSNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:label xml:lang="en">WBS Node</rdfs:label>
    <skos:altLabel xml:lang="de">PSP-Knoten</skos:altLabel>
    <skos:altLabel xml:lang="de">WBS-Knoten</skos:altLabel>
    <rdfs:comment xml:lang="en">A Breakdown Node that belongs to a Work Breakdown Structure and represents a work-scope category or hierarchy element.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b2"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b13">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#CBSNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:label xml:lang="en">CBS Node</rdfs:label>
    <skos:altLabel xml:lang="de">Kostengliederungsknoten</skos:altLabel>
    <skos:altLabel xml:lang="en">Cost Breakdown Node</skos:altLabel>
    <skos:altLabel xml:lang="de">Cost-Breakdown-Knoten</skos:altLabel>
    <rdfs:comment xml:lang="en">A Breakdown Node that belongs to a Cost Breakdown Structure and represents a cost-related hierarchy element.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b11"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">identifier</rdfs:label>
    <skos:altLabel xml:lang="de">Kennung</skos:altLabel>
    <skos:altLabel xml:lang="de">Identifikator</skos:altLabel>
    <rdfs:comment xml:lang="en">A mandatory domain identifier for a Breakdown Structure or Breakdown Node within its information context. Mandatory cardinality is enforced by the Core SHACL profile.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verpflichtende fachliche Kennung einer Breakdown Structure oder eines Breakdown Node innerhalb seines Informationskontexts. Die verpflichtende Kardinalität wird durch das Core-SHACL-Profil geprüft.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b3">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#LocationBreakdownStructure"/>
    <rdf:rest rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b2">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#WorkBreakdownStructure"/>
    <rdf:rest rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Breakdown Node</rdfs:label>
    <skos:altLabel xml:lang="de">Gliederungsknoten</skos:altLabel>
    <rdfs:comment xml:lang="en">A node within a Breakdown Structure. A node represents one element of the hierarchy and may have at most one direct parent node.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b9">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#SBSNode"/>
    <rdf:rest rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#SBSNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdfs:label xml:lang="en">SBS Node</rdfs:label>
    <skos:altLabel xml:lang="de">Systemgliederungsknoten</skos:altLabel>
    <skos:altLabel xml:lang="en">System Breakdown Node</skos:altLabel>
    <skos:altLabel xml:lang="de">System-Breakdown-Knoten</skos:altLabel>
    <rdfs:comment xml:lang="en">A Breakdown Node that belongs to a System Breakdown Structure and represents a system-related hierarchy element.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/breakdown-structure#name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b14"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <skos:altLabel xml:lang="de">Bezeichnung</skos:altLabel>
    <rdfs:comment xml:lang="en">Optional human-readable name of a Breakdown Structure or Breakdown Node.</rdfs:comment>
    <rdfs:comment xml:lang="de">Optionale menschenlesbare Bezeichnung einer Breakdown Structure oder eines Breakdown Node.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/breakdown-structure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b12">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownStructure"/>
    <rdf:rest rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b13"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b7">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#WBSNode"/>
    <rdf:rest rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b15">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownStructure"/>
    <rdf:rest rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b16"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b4">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#SystemBreakdownStructure"/>
    <rdf:rest rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b5"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b10">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#CBSNode"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b16">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#BreakdownNode"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b8">
    <rdf:first rdf:resource="https://www.construct-x.org/ontology/breakdown-structure#LBSNode"/>
    <rdf:rest rdf:nodeID="na7aa1f5d52c04f3e9813d7c0597a50c9b9"/>
  </rdf:Description>
</rdf:RDF>
