    dcterms:source "Provided classification excerpt: GR51 Location Breakdown; M270-M283." ;
    vann:preferredNamespacePrefix "conx-de-lbs" ;
    vann:preferredNamespaceUri "https://www.construct-x.org/vocab/breakdown-structure/de-lbs-node-type#" .

