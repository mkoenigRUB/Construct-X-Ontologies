<https://www.construct-x.org/vocab/breakdown-structure/de-sbs-node-type>
    a owl:Ontology ;
    owl:versionIRI <https://www.construct-x.org/vocab/breakdown-structure/de-sbs-node-type/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Construct-X DE SBS Node Type Vocabulary"@en ;
    dcterms:title "Construct-X-DE-Vokabular für SBS-Knotentypen"@de ;
    dcterms:description "Germany-specific controlled vocabulary for semantic node types of System Breakdown Structures (SBS), based on the supplied classification excerpt GR52 / M264-M269."@en ;
    dcterms:description "Deutschland-spezifisches kontrolliertes Vokabular für fachliche Knotentypen von System Breakdown Structures (SBS), basierend auf dem bereitgestellten Klassifikationsauszug GR52 / M264-M269."@de ;
    dcterms:publisher <https://www.construct-x.org/id/organization/construct-x> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-02"^^xsd:date ;
    dcterms:modified "2026-10-21"^^xsd:date ;
    dcterms:source "Provided classification excerpt: GR52 System Breakdown; M264-M269." ;
    vann:preferredNamespacePrefix "conx-de-sbs" ;
    vann:preferredNamespaceUri "https://www.construct-x.org/vocab/breakdown-structure/de-sbs-node-type#" .

