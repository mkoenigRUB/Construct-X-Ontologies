<https://www.construct-x.org/vocab/breakdown-structure/de-cbs-node-type>
    a owl:Ontology ;
    owl:versionIRI <https://www.construct-x.org/vocab/breakdown-structure/de-cbs-node-type/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Construct-X DE CBS Node Type Vocabulary"@en ;
    dcterms:title "Construct-X-DE-Vokabular für CBS-Knotentypen"@de ;
    dcterms:description "Germany-specific controlled vocabulary for semantic node types of Cost Breakdown Structures (CBS). The current concepts represent first-level cost groups according to DIN 276:2018-12."@en ;
    dcterms:description "Deutschland-spezifisches kontrolliertes Vokabular für fachliche Knotentypen von Cost Breakdown Structures (CBS). Die aktuellen Konzepte bilden Kostengruppen der ersten Ebene nach DIN 276:2018-12 ab."@de ;
    dcterms:publisher <https://www.construct-x.org/id/organization/construct-x> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-02"^^xsd:date ;
    dcterms:modified "2026-10-21"^^xsd:date ;
    dcterms:source "DIN 276:2018-12, 5.1" ;
    vann:preferredNamespacePrefix "conx-de-cbs" ;
    vann:preferredNamespaceUri "https://www.construct-x.org/vocab/breakdown-structure/de-cbs-node-type#" .

