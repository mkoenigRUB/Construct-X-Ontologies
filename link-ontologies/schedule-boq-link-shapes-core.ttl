@prefix conx-cs: <https://www.construct-x.org/ontology/construction-schedule#> .
@prefix conx-gaeb: <https://www.construct-x.org/ontology/gaeb-boq#> .
@prefix conx-sbq: <https://www.construct-x.org/ontology/schedule-boq-link#> .
@prefix conx-sbq-sh: <https://www.construct-x.org/shapes/schedule-boq-link#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://www.construct-x.org/shapes/schedule-boq-link/core>
    a owl:Ontology ;
    owl:versionIRI <https://www.construct-x.org/shapes/schedule-boq-link/core/0.2.1> ;
    owl:versionInfo "0.2.1" ;
    owl:imports
        <https://www.construct-x.org/ontology/construction-schedule/0.5.0> ,
        <https://www.construct-x.org/ontology/gaeb-boq/0.5.0> ,
        <https://www.construct-x.org/ontology/schedule-boq-link/0.2.1> ;
    dcterms:title "Construct-X Schedule–BoQ Link Core SHACL Profile"@en .

conx-sbq-sh:ConstructionScheduleBoQShape
    a sh:NodeShape ;
    sh:targetClass conx-cs:ConstructionSchedule ;
    sh:property [
        sh:path conx-sbq:usesBillOfQuantities ;
        sh:class conx-gaeb:BillOfQuantities
    ] .

conx-sbq-sh:QuantitySplitActivityAssignmentShape
    a sh:NodeShape ;
    sh:targetClass conx-gaeb:QuantitySplit ;
    sh:property [
        sh:path conx-sbq:isAssignedToActivity ;
        sh:class conx-cs:Activity ;
        sh:maxCount 1
    ] .
