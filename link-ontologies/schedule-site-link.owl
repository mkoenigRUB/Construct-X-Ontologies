<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
 >
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/schedule-site-link">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/ontology/schedule-site-link/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <owl:imports rdf:resource="https://www.construct-x.org/ontology/construction-schedule/0.5.0"/>
    <owl:imports rdf:resource="https://www.construct-x.org/ontology/construction-site/0.2.0"/>
    <dcterms:title xml:lang="en">Construct-X Schedule–Site Link Ontology</dcterms:title>
    <dcterms:title xml:lang="de">Construct-X-Verknüpfungsontologie für Terminplan und Baustelle</dcterms:title>
    <dcterms:description xml:lang="en">Links time-bounded site area allocations to the schedule activities that drive them, keeping the source ontologies independent.</dcterms:description>
    <dcterms:description xml:lang="de">Verknüpft zeitlich begrenzte Flächenbelegungen der Baustelle mit den Terminplanvorgängen, die sie auslösen, während die Fachontologien unabhängig bleiben.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-22</dcterms:created>
    <vann:preferredNamespacePrefix>conx-ssl</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/ontology/schedule-site-link#</vann:preferredNamespaceUri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/schedule-site-link#allocatedForActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://www.construct-x.org/ontology/schedule-site-link#requiresAreaAllocation"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-site#AreaAllocation"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-schedule#Activity"/>
    <rdfs:label xml:lang="en">allocated for activity</rdfs:label>
    <skos:altLabel xml:lang="de">belegt für Vorgang</skos:altLabel>
    <rdfs:comment xml:lang="en">Associates a time-bounded area allocation with the schedule activity whose execution requires that area to be used in the given functional type.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/schedule-site-link"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/schedule-site-link#requiresAreaAllocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/construction-schedule#Activity"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/construction-site#AreaAllocation"/>
    <rdfs:label xml:lang="en">requires area allocation</rdfs:label>
    <skos:altLabel xml:lang="de">benötigt Flächenbelegung</skos:altLabel>
    <rdfs:comment xml:lang="en">Associates a schedule activity with the time-bounded area allocations it requires.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/schedule-site-link"/>
  </rdf:Description>
</rdf:RDF>
