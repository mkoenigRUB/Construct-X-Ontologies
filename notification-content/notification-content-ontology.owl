<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:description xml:lang="de">Entwurf eines Construct-X-Fachmodells für Benachrichtigungsinhalte. Transport- und Routing-Metadaten wie messageId, Sender, Empfänger, Zeitstempel und relatedMessageId werden bewusst nicht modelliert; sie verbleiben im externen Notification-Header, z. B. nach Industry Core / Tractus-X.</dcterms:description>
    <dcterms:description xml:lang="en">Draft Construct-X business-content model for notifications. It deliberately excludes transport and routing metadata such as messageId, sender, receiver, timestamps and relatedMessageId; these remain in the external notification header (e.g. an Industry Core / Tractus-X message header).</dcterms:description>
    <dcterms:title xml:lang="de">Construct-X Ontologie für Benachrichtigungsinhalte</dcterms:title>
    <dcterms:title xml:lang="en">Construct-X Notification Content Ontology</dcterms:title>
    <owl:versionIRI rdf:resource="https://www.construct-x.org/ontology/notification-content/0.1.1"/>
    <vann:preferredNamespacePrefix>conx-nc</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://www.construct-x.org/ontology/notification-content#</vann:preferredNamespaceUri>
    <owl:versionInfo>0.1.1</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#NotificationContent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Notification Content</rdfs:label>
    <rdfs:comment xml:lang="de">Fachsemantischer Inhalt innerhalb eines technischen Notification-Umschlags.</rdfs:comment>
    <rdfs:comment xml:lang="en">Business-semantic content carried inside a technical notification envelope.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <skos:altLabel xml:lang="de">Benachrichtigungsinhalt</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#taskStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">task status</rdfs:label>
    <rdfs:comment xml:lang="de">In einer Statusbenachrichtigung mitgeteilter Bearbeitungsstatus.</rdfs:comment>
    <rdfs:comment xml:lang="en">Status communicated in a task-status notification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/notification-content#NotificationContent"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="de">Auftragsstatus</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#hasSubjectAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has subject assignment</rdfs:label>
    <rdfs:comment xml:lang="de">Verknüpft die Benachrichtigung mit einem oder mehreren Ziel- oder Kontextobjekten.</rdfs:comment>
    <rdfs:comment xml:lang="en">Associates the notification with one or more target or context resources.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/notification-content#NotificationContent"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <rdfs:range rdf:resource="https://www.construct-x.org/ontology/notification-content#SubjectAssignment"/>
    <skos:altLabel xml:lang="de">hat Objektzuordnung</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#notificationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">notification type</rdfs:label>
    <rdfs:comment xml:lang="de">Klassifiziert die fachliche Bedeutung der Benachrichtigung.</rdfs:comment>
    <rdfs:comment xml:lang="en">Classifies the business meaning of the notification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/notification-content#NotificationContent"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="de">Benachrichtigungstyp</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#contextResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">context resource</rdfs:label>
    <rdfs:comment xml:lang="de">Verweist auf einen eigenständigen fachlichen Dateninhalt, der den Kontext für die Benachrichtigung bereitstellt.</rdfs:comment>
    <rdfs:comment xml:lang="en">References a separate business data resource providing context for the notification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/notification-content#NotificationContent"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <skos:altLabel xml:lang="de">Kontextressource</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#SubjectAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Subject Assignment</rdfs:label>
    <rdfs:comment xml:lang="de">Ordnet einem Objekt seine Rolle innerhalb einer Benachrichtigung zu.</rdfs:comment>
    <rdfs:comment xml:lang="en">Associates a resource with its role in a notification.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <skos:altLabel xml:lang="de">Objektzuordnung</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#assignedResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">assigned resource</rdfs:label>
    <rdfs:comment xml:lang="de">Von der Benachrichtigung referenziertes Objekt.</rdfs:comment>
    <rdfs:comment xml:lang="en">Resource referenced by the notification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/notification-content#SubjectAssignment"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <skos:altLabel xml:lang="de">zugeordnetes Objekt</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#subjectRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">subject role</rdfs:label>
    <rdfs:comment xml:lang="de">Rolle des Objekts innerhalb der Benachrichtigung, z. B. Target oder ContextOnly.</rdfs:comment>
    <rdfs:comment xml:lang="en">Role of the resource within the notification, e.g. Target or ContextOnly.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/notification-content#SubjectAssignment"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="de">Objektrolle</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#hasResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has result</rdfs:label>
    <rdfs:comment xml:lang="de">Durch die Benachrichtigung bereitgestelltes Ergebnisobjekt.</rdfs:comment>
    <rdfs:comment xml:lang="en">Result resource made available by the notification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/notification-content#NotificationContent"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <skos:altLabel xml:lang="de">hat Ergebnis</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.construct-x.org/ontology/notification-content#taskType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">task type</rdfs:label>
    <rdfs:comment xml:lang="de">Angeforderter Aufgabentyp, wenn die Benachrichtigung einen Arbeitsauftrag oder eine auftragsbezogene Folgemeldung darstellt.</rdfs:comment>
    <rdfs:comment xml:lang="en">Requested task type when the notification represents a task request or a task-related follow-up.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.construct-x.org/ontology/notification-content#NotificationContent"/>
    <rdfs:isDefinedBy rdf:resource="https://www.construct-x.org/ontology/notification-content"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="de">Aufgabentyp</skos:altLabel>
  </rdf:Description>
</rdf:RDF>
